{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@orbit-js/registry": ["../../../src/registry/index.ts"],
      "@orbit-js/http": ["../../../src/http/index.ts"],
      "@orbit-js/context": ["../../../src/context/index.ts"],
      "@orbit-js/pipeline": ["../../../src/pipeline/index.ts"],
      "@orbit-js/task": ["../../../src/task/index.ts"],
      "@orbit-js/error": ["../../../src/error/index.ts"],
      "@orbit-js/logger": ["../../../src/logger/index.ts"],
      "@orbit-js/utils": ["../../../src/utils/index.ts"],
      "@orbit-js/events": ["../../../src/events/index.ts"],
      "@orbit-js/cache": ["../../../src/cache/index.ts"],
      "@orbit-js/data-processor": ["../../../src/data-processor/index.ts"],
      "@orbit-js/data-processor-abp": ["../../../src/data-processor-abp/index.ts"],
      "@orbit-js/data-processor-spring": ["../../../src/data-processor-spring/index.ts"],
      "@orbit-js/oauth2": ["../../../src/oauth2/index.ts"],
      "@orbit-js/i18n": ["../../../src/i18n/index.ts"],
      "@orbit-js/mime": ["../../../src/mime/index.ts"],
      "@orbit-js/pattern": ["../../../src/pattern/index.ts"],
      "@orbit-js/schema": ["../../../src/schema/index.ts"],
      "@orbit-js/composable": ["../../../src/composable/index.ts"],
      "@orbit-js/system-abilities": ["../../../src/system-abilities/index.ts"],
      "@orbit-js/async": ["../../../src/async/index.ts"],
      "@orbit-js/runtime": ["../../../src/runtime/index.ts"],
      "@orbit-js/crypto": ["../../../src/crypto/index.ts"],
      "@orbit-js/types": ["../../../src/types/index.ts"],
      "@orbit-js/validation": ["../../../src/validation/index.ts"],
      "@orbit-js/entity": ["../../../src/entity/index.ts"],
      "@orbit-js/event-dom": ["../../../src/event-dom/index.ts"],
      "@/*": ["../../../src/*"]
    }
  },
  "include": ["src/**/*"]
}
