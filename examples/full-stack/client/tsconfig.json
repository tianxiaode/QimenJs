{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@qimenjs/registry": ["../../../src/registry/index.ts"],
      "@qimenjs/http": ["../../../src/http/index.ts"],
      "@qimenjs/context": ["../../../src/context/index.ts"],
      "@qimenjs/pipeline": ["../../../src/pipeline/index.ts"],
      "@qimenjs/task": ["../../../src/task/index.ts"],
      "@qimenjs/error": ["../../../src/error/index.ts"],
      "@qimenjs/logger": ["../../../src/logger/index.ts"],
      "@qimenjs/utils": ["../../../src/utils/index.ts"],
      "@qimenjs/events": ["../../../src/events/index.ts"],
      "@qimenjs/cache": ["../../../src/cache/index.ts"],
      "@qimenjs/data-processor": ["../../../src/data-processor/index.ts"],
      "@qimenjs/data-processor-abp": ["../../../src/data-processor-abp/index.ts"],
      "@qimenjs/data-processor-spring": ["../../../src/data-processor-spring/index.ts"],
      "@qimenjs/oauth2": ["../../../src/oauth2/index.ts"],
      "@qimenjs/i18n": ["../../../src/i18n/index.ts"],
      "@qimenjs/mime": ["../../../src/mime/index.ts"],
      "@qimenjs/pattern": ["../../../src/pattern/index.ts"],
      "@qimenjs/schema": ["../../../src/schema/index.ts"],
      "@qimenjs/composable": ["../../../src/composable/index.ts"],
      "@qimenjs/system-abilities": ["../../../src/system-abilities/index.ts"],
      "@qimenjs/async": ["../../../src/async/index.ts"],
      "@qimenjs/runtime": ["../../../src/runtime/index.ts"],
      "@qimenjs/crypto": ["../../../src/crypto/index.ts"],
      "@qimenjs/types": ["../../../src/types/index.ts"],
      "@qimenjs/validation": ["../../../src/validation/index.ts"],
      "@qimenjs/entity": ["../../../src/entity/index.ts"],
      "@qimenjs/event-dom": ["../../../src/event-dom/index.ts"],
      "@/*": ["../../../src/*"]
    }
  },
  "include": ["src/**/*"]
}
