{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@orbitjs/registry": ["../../../src/registry/index.ts"],
      "@orbitjs/http": ["../../../src/http/index.ts"],
      "@orbitjs/context": ["../../../src/context/index.ts"],
      "@orbitjs/pipeline": ["../../../src/pipeline/index.ts"],
      "@orbitjs/task": ["../../../src/task/index.ts"],
      "@orbitjs/error": ["../../../src/error/index.ts"],
      "@orbitjs/logger": ["../../../src/logger/index.ts"],
      "@orbitjs/utils": ["../../../src/utils/index.ts"],
      "@orbitjs/events": ["../../../src/events/index.ts"],
      "@orbitjs/cache": ["../../../src/cache/index.ts"],
      "@orbitjs/data-processor": ["../../../src/data-processor/index.ts"],
      "@orbitjs/data-processor-abp": ["../../../src/data-processor-abp/index.ts"],
      "@orbitjs/data-processor-spring": ["../../../src/data-processor-spring/index.ts"],
      "@orbitjs/oauth2": ["../../../src/oauth2/index.ts"],
      "@orbitjs/i18n": ["../../../src/i18n/index.ts"],
      "@orbitjs/mime": ["../../../src/mime/index.ts"],
      "@orbitjs/pattern": ["../../../src/pattern/index.ts"],
      "@orbitjs/schema": ["../../../src/schema/index.ts"],
      "@orbitjs/composable": ["../../../src/composable/index.ts"],
      "@orbitjs/system-abilities": ["../../../src/system-abilities/index.ts"],
      "@orbitjs/async": ["../../../src/async/index.ts"],
      "@orbitjs/runtime": ["../../../src/runtime/index.ts"],
      "@orbitjs/crypto": ["../../../src/crypto/index.ts"],
      "@orbitjs/types": ["../../../src/types/index.ts"],
      "@orbitjs/validation": ["../../../src/validation/index.ts"],
      "@orbitjs/entity": ["../../../src/entity/index.ts"],
      "@orbitjs/event-dom": ["../../../src/event-dom/index.ts"],
      "@/*": ["../../../src/*"]
    }
  },
  "include": ["src/**/*"]
}
