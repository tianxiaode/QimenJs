{
  "name": "qimenjs-full-stack-example",
  "version": "1.0.0",
  "private": true,
  "description": "QimenJS 全栈示例：OAuth2 认证 + ABP API + Spring API + 前端多域数据获取",
  "scripts": {
    "start": "node scripts/start-all.js",
    "stop": "node scripts/stop-all.js",
    "auth": "node servers/auth-server/index.js",
    "abp": "node servers/abp-api/index.js",
    "spring": "node servers/spring-api/index.js",
    "client": "cd client && npx vite --open",
    "build:qimenjs": "cd ../.. && npm run build"
  },
  "dependencies": {
