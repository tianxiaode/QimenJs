{
    "modules": {
        "runtime-env": {
            "entry": "src/runtime-env/index.ts",
            "outDir": "dist/runtime-env",
            "rootDir": "src/runtime-env",
            "dependencies": [],
            "packageName": "@orbitjs/runtime-env"
        },

        "utils": {
            "entry": "src/utils/index.ts",
            "outDir": "dist/utils",
            "rootDir": "src/utils",
            "dependencies": ["runtime-env"],
            "packageName": "@orbitjs/utils"
        },

        "validation": {
            "entry": "src/validation/index.ts",
            "outDir": "dist/validation",
            "rootDir": "src/validation",
            "dependencies": ["error"],
            "packageName": "@orbitjs/validation"
        },

        "error": {
            "entry": "src/error/index.ts",
            "outDir": "dist/error",
            "rootDir": "src/error",
            "dependencies": [],
            "packageName": "@orbitjs/error"
        },

        "logger": {
            "entry": "src/logger/index.ts",
            "outDir": "dist/logger",
            "rootDir": "src/logger",
            "dependencies": ["runtime-env", "error"],
            "packageName": "@orbitjs/logger"
        },

        "event-core": {
            "entry": "src/event/index.ts",
            "outDir": "dist/event",
            "rootDir": "src/event",
            "dependencies": [],
            "packageName": "@orbitjs/event"
        },
        "async": {
            "entry": "src/async/index.ts",
            "outDir": "dist/async",
            "rootDir": "src/async",
            "dependencies": [],
            "packageName": "@orbitjs/async"
        },

        "core": {
            "entry": "src/core/index.ts",
            "outDir": "dist/core",
            "rootDir": "src/core",
            "dependencies": ["utils", "validation", "error", "logger", "event"],
            "packageName": "@orbitjs/core"
        },
        "tasks": {
            "entry": "src/tasks/index.ts",
            "outDir": "dist/tasks",
            "rootDir": "src/tasks",
            "dependencies": ["utils", "crypto", "error", "logger"],
            "packageName": "@orbitjs/tasks"
        },
        "crypto": {
            "entry": "src/crypto/index.ts",
            "outDir": "dist/crypto",
            "rootDir": "src/crypto",
            "dependencies": [],
            "packageName": "@orbitjs/crypto"
        },
        "http": {
            "entry": "src/http/index.ts",
            "outDir": "dist/http",
            "rootDir": "src/http",
            "dependencies": ["utils", "error"],
            "packageName": "@orbitjs/http"
        },
        "repository": {
            "entry": "src/repository/index.ts",
            "outDir": "dist/repository",
            "rootDir": "src/repository",
            "dependencies": ["utils", "validation", "error", "logger", "http"],
            "packageName": "@orbitjs/repository"
        }
    },

    "build": {
        "tsconfig": "tsconfig.build.json",
        "formats": ["cjs", "esm"],
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true
    }
}
