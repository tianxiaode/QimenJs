{
  "modules": {
    "error": {
      "entry": "src/error/index.ts",
      "outDir": "dist/error",
      "rootDir": "src/error",
      "dependencies": [],
      "packageName": "@orbitjs/error"
    },
    "logger": {
      "entry": "src/logger/index.ts",
      "outDir": "dist/logger",
      "rootDir": "src/logger",
      "dependencies": [],
      "packageName": "@orbitjs/logger"
    },
    "utils": {
      "entry": "src/utils/index.ts",
      "outDir": "dist/utils",
      "rootDir": "src/utils",
      "dependencies": [],
      "packageName": "@orbitjs/utils"
    },
    "async": {
      "entry": "src/async/index.ts",
      "outDir": "dist/async",
      "rootDir": "src/async",
      "dependencies": [],
      "packageName": "@orbitjs/async"
    },
    "runtime": {
      "entry": "src/runtime/index.ts",
      "outDir": "dist/runtime",
      "rootDir": "src/runtime",
      "dependencies": [],
      "packageName": "@orbitjs/runtime"
    },
    "crypto": {
      "entry": "src/crypto/index.ts",
      "outDir": "dist/crypto",
      "rootDir": "src/crypto",
      "dependencies": [],
      "packageName": "@orbitjs/crypto"
    },
    "registry": {
      "entry": "src/registry/index.ts",
      "outDir": "dist/registry",
      "rootDir": "src/registry",
      "dependencies": ["error"],
      "packageName": "@orbitjs/registry"
    },
    "cache": {
      "entry": "src/cache/index.ts",
      "outDir": "dist/cache",
      "rootDir": "src/cache",
      "dependencies": ["logger", "utils"],
      "packageName": "@orbitjs/cache"
    },
    "events": {
      "entry": "src/events/index.ts",
      "outDir": "dist/events",
      "rootDir": "src/events",
      "dependencies": ["logger", "utils"],
      "packageName": "@orbitjs/events"
    },
    "validation": {
      "entry": "src/validation/index.ts",
      "outDir": "dist/validation",
      "rootDir": "src/validation",
      "dependencies": ["registry"],
      "packageName": "@orbitjs/validation"
    },
    "task": {
      "entry": "src/task/index.ts",
      "outDir": "dist/task",
      "rootDir": "src/task",
      "dependencies": ["logger", "utils", "error", "runtime"],
      "packageName": "@orbitjs/task"
    },
    "kernel": {
      "entry": "src/kernel/index.ts",
      "outDir": "dist/kernel",
      "rootDir": "src/kernel",
      "dependencies": ["registry", "logger", "utils", "async", "events", "cache"],
      "packageName": "@orbitjs/kernel"
    },
    "entity": {
      "entry": "src/entity/index.ts",
      "outDir": "dist/entity",
      "rootDir": "src/entity",
      "dependencies": ["kernel", "validation"],
      "packageName": "@orbitjs/entity"
    }
  },
  "build": {
    "tsconfig": "tsconfig.build.json",
    "formats": ["cjs", "esm"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  }
}
