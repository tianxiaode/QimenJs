{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "lib": ["ES2018", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@orbitjs/async": ["src/async"],
      "@orbitjs/base": ["src/base"],
      "@orbitjs/core": ["src/core"],
      "@orbitjs/error": ["src/error"],
      "@orbitjs/event-core": ["src/event-core"],
      "@orbitjs/event-dom": ["src/event-dom"],
      "@orbitjs/logger": ["src/logger"],
      "@orbitjs/runtime-env": ["src/runtime-env"],
      "@orbitjs/utils": ["src/utils"],
      "@orbitjs/validation": ["src/validation"],
    }
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}