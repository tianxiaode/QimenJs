{
  "name": "@qimen-lab/core",
  "version": "0.1.2",
  "description": "QimenJS - Modern TypeScript infrastructure library inspired by Qimen Dunjia",
  "keywords": [
    "qimenjs",
    "qimen",
    "entity",
    "pipeline",
    "composable",
    "typescript"
  ],
  "sideEffects": false,
