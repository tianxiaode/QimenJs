{
  "name": "qimenjs",
  "version": "0.2.0",
  "description": "QimenJS - Modern TypeScript infrastructure library inspired by Qimen Dunjia",
  "private": true,
  "keywords": [
    "qimenjs",
    "qimen",
    "entity",
    "pipeline",
    "composable",
    "typescript"
  ],
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "node scripts/build.js",
    "build:clean": "node scripts/build.js --clean",
    "build:core": "node scripts/build.js core",
    "build:utils": "node scripts/build.js utils",
    "build:validation": "node scripts/build.js validation",
    "build:core-clean": "node scripts/build.js core --clean",
    "publish:all": "node scripts/publish.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:core": "jest --testPathPattern=test/unit/core",
    "test:utils": "jest --testPathPattern=test/unit/utils",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\"",
    "dev": "tsc --watch",
    "generate:test": "node scripts/generate-tests.js",
    "generate:test:custom": "node scripts/generate-tests.js --src src --test test/unit",
    "docs": "typedoc"
  },
  "author": "Huang Dengqiao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianxiaode/QimenJs"
  },
  "bugs": {
    "url": "https://github.com/tianxiaode/QimenJs/issues"
  },
  "homepage": "https://github.com/tianxiaode/QimenJs#readme",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "fantasticon": "^4.1.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^30.2.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "svg2ttf": "^6.1.0",
    "svgpath": "^2.6.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "ttf2woff2": "^8.0.1",
    "typedoc": "^0.28.15",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
