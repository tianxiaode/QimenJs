  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "node scripts/build.js",
    "build:clean": "node scripts/build.js --clean",
    "build:core": "node scripts/build.js core",
    "build:utils": "node scripts/build.js utils",
    "build:validation": "node scripts/build.js validation",
    "build:core-clean": "node scripts/build.js core --clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:core": "jest --testPathPattern=test/unit/core",
    "test:utils": "jest --testPathPattern=test/unit/utils",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\"",
    "dev": "tsc --watch",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "generate:test": "node scripts/generate-tests.js",
    "generate:test:custom": "node scripts/generate-tests.js --src src --test test/unit",
    "docs": "typedoc"
  },
  "author": "Huang Dengqiao",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianxiaode/QimenJs"
  },
  "bugs": {
