{
  "name": "QimenJS Demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [80, 3000, 3001, 3002],
  "portsAttributes": {
    "80": {
      "label": "QimenJS Demo (Nginx)",
      "onAutoForward": "openPreview",
      "visibility": "public"
    },
    "3000": {
      "label": "Auth Server",
      "visibility": "public"
    },
    "3001": {
      "label": "ABP API",
      "visibility": "public"
    },
    "3002": {
      "label": "Spring API",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash .devcontainer/infra_setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
